<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="MapAssets\live-tracking-map.html" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="MapAssets\live-tracking-map.html">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FleetFlow.Application\FleetFlow.Application.csproj" />
		<ProjectReference Include="..\FleetFlow.Infrastructure\FleetFlow.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>